---
interface Props {
  id: string;
  label: string;
  value: number;
  hint?: string;
  prefix?: string;
  suffix?: string;
  step?: number;
  min?: number;
  max?: number;
}
const { id, label, value, hint, prefix, suffix, step = 1, min = 0, max } = Astro.props;
---
<div class="field">
  <label for={id}>{label}</label>
  <div class="control">
    {prefix && <span class="affix" aria-hidden="true">{prefix}</span>}
    <input id={id} name={id} type="number" inputmode="decimal" value={value} step={step} min={min} max={max} aria-describedby={hint ? `${id}-hint` : undefined} />
    {suffix && <span class="affix" aria-hidden="true">{suffix}</span>}
  </div>
  {hint && <p class="hint small muted" id={`${id}-hint`}>{hint}</p>}
</div>

<style>
  .field { margin-bottom: var(--space-4); }
  label { display: block; font-weight: 700; margin-bottom: var(--space-1); }
  .control {
    display: flex;
    align-items: center;
    background: var(--sheet);
    border: 1.5px solid var(--rule-strong);
    border-radius: var(--radius-control);
    min-height: 48px;
    padding: 0 var(--space-3);
  }
  .control:focus-within { border-color: var(--focus); box-shadow: 0 0 0 2px var(--focus); }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: var(--step-1);
    font-variant-numeric: tabular-nums;
    padding: var(--space-2) var(--space-2);
  }
  input:focus { outline: none; }
  .affix { color: var(--ink-2); font-weight: 700; }
  .hint { margin: var(--space-1) 0 0; }
</style>
