---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---
<Base title="Page not found">
  <div class="wrap page">
    <h1>This slot is empty.</h1>
    <p class="lead">The page you're looking for doesn't exist, or you're offline and haven't opened it before.</p>
    <p><a class="btn" href={url('')}>Go to the guide</a></p>
    <p><a href={url('search')}>Search instead</a></p>
  </div>
</Base>

<style>
  .page { padding-top: var(--space-6); }
  .lead { font-size: var(--step-1); color: var(--ink-2); }
</style>
